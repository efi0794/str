{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hoyo-daily-status",
  "main": "src/index.js",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hoyo-daily-status",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 12 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
